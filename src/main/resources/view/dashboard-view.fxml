<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.recursos.humanos.reclutamiento.aspirantes.controller.DashboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Barra Superior / Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Panel de Control - Reclutamiento de Aspirantes">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <HBox HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCerrarSesion" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Cerrar Sesión" />
    </HBox>

    <!-- Contenido Principal: Formulario y Tabla -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        
        <!-- Panel Izquierdo: Formulario -->
        <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 5;">
            <Label text="Gestión de Aspirante">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>

            <VBox spacing="2.0">
                <Label text="ID Aspirante:" />
                <TextField fx:id="txtIdAspirante" promptText="ej. ASP-001" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="ID País:" />
                <TextField fx:id="txtIdPais" promptText="ej. PAIS-01" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="ID Usuario:" />
                <TextField fx:id="txtIdUsuario" promptText="ej. USU-001" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="Nombre:" />
                <TextField fx:id="txtNombre" promptText="Nombre" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="Apellido:" />
                <TextField fx:id="txtApellido" promptText="Apellido" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="Teléfono:" />
                <TextField fx:id="txtTelefono" promptText="Teléfono" />
            </VBox>

            <VBox spacing="2.0">
                <Label text="Edad:" />
                <TextField fx:id="txtEdad" promptText="Edad" />
            </VBox>

            <!-- Botones CRUD -->
            <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                <Button maxWidth="Infinity" onAction="#handleGuardar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
                <Button maxWidth="Infinity" onAction="#handleActualizar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar" />
                <Button maxWidth="Infinity" onAction="#handleEliminar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                <Button maxWidth="Infinity" onAction="#handleLimpiar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Limpiar Campos" />
            </VBox>
        </VBox>

        <!-- Panel Derecho: Tabla de Registros -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Lista de Aspirantes Registrados">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            
            <TableView fx:id="tableAspirantes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdAspirante" prefWidth="90.0" text="ID Aspirante" />
                    <TableColumn fx:id="colIdPais" prefWidth="75.0" text="ID País" />
                    <TableColumn fx:id="colIdUsuario" prefWidth="75.0" text="ID Usuario" />
                    <TableColumn fx:id="colNombre" prefWidth="110.0" text="Nombre" />
                    <TableColumn fx:id="colApellido" prefWidth="110.0" text="Apellido" />
                    <TableColumn fx:id="colTelefono" prefWidth="95.0" text="Teléfono" />
                    <TableColumn fx:id="colEdad" prefWidth="60.0" text="Edad" />
                </columns>
            </TableView>
        </VBox>
        
    </HBox>

</VBox>
